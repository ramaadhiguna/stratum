# Local development values for deploy/docker-compose.yml.
# Copy to deploy/.env (git-ignored) and change if you like. Never put real credentials here.

# S3 stand-in (RustFS). Also used as the AWS access key / secret by clients talking to it.
S3_ACCESS_KEY=stratum
S3_SECRET_KEY=stratum-dev-secret
AWS_REGION=us-east-1

# PostgreSQL
POSTGRES_USER=stratum
POSTGRES_PASSWORD=stratum-dev
POSTGRES_DB=stratum
