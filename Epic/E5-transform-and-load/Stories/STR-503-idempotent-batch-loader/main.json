  "aws_equivalent": "RDS PostgreSQL",
  "user_story": {
    "as_a": "platform",
    "i_want": "each staged batch inserted in one transaction with duplicates ignored",
    "so_that": "retries never double-count data"
  },
  "description": "Load with `INSERT ... SELECT * FROM UNNEST($1::uuid[], $2::timestamptz[], ...) ON CONFLICT DO NOTHING`, in chunks of 5,000 rows per statement and one transaction per staged file. Report inserted vs duplicate counts from rows_affected. Share one generic helper or `macro_rules!` across the 3 tables instead of copy-pasting. Stretch: compare against COPY.",
  "acceptance_criteria": [
    {
      "id": "AC1",
      "given": "a staged file",
      "when": "it is loaded twice",
      "then": "the second load inserts 0 rows and reports them all as duplicates"
    },
    {
      "id": "AC2",
      "given": "50k rows in a release build",
      "when": "they are loaded locally",
      "then": "it takes under 5 s"
    },
    {
      "id": "AC3",
      "given": "a failure in the middle of a file",
      "when": "it is loaded",
      "then": "the whole file's transaction rolls back"
    },
    {
      "id": "AC4",
      "given": "the 3 tables",
      "when": "they are loaded",
      "then": "they share one helper or macro"
    }
  ],
  "out_of_scope": [],
  "rust_concepts": [
    "Building column vectors",
    "Transactions (&mut *tx)",
    "Generic helpers or declarative macros (macro_rules!)",
    "rows_affected"
  ],
