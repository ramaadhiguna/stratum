  "user_story": {
    "as_a": "developer",
    "i_want": "a CLI that generates realistic telemetry at a chosen rate",
    "so_that": "I can exercise and demo the pipeline"
  },
  "description": "`stratum-cli generate --rate 200 --duration 60s --api-key <key>` sends a mix of metric/event/log envelopes for the seeded sources (STR-401 seed file). Options: `--invalid-ratio` and `--unknown-source-ratio`, plus a batch size. It honours 503 Retry-After and prints a summary: sent, accepted, rejected, retries, p50/p99 latency.",
  "acceptance_criteria": [
    {
      "id": "AC1",
      "given": "--rate 200 --duration 60s",
      "when": "the generator runs",
      "then": "the achieved rate is within ±10%"
    },
    {
      "id": "AC2",
      "given": "--invalid-ratio 0.05",
      "when": "the run finishes",
      "then": "about 5% of records are reported rejected"
    },
    {
      "id": "AC3",
      "given": "the API returns 503 with Retry-After",
      "when": "the generator receives it",
      "then": "it waits and retries instead of dropping the batch"
    }
  ],
