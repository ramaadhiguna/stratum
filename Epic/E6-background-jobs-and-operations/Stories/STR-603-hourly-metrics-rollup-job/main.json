  "user_story": {
    "as_a": "analyst",
    "i_want": "hourly aggregates of metrics",
    "so_that": "dashboards don't scan raw rows"
  },
  "description": "Create `telemetry.metrics_hourly` (tenant_id, source_id, name, hour, count, sum, min, max) with a composite PK. The `rollup-metrics-hourly` job runs at :10 past each hour. It aggregates the previous complete hour and re-aggregates the hour before it (to absorb late data) with `INSERT ... SELECT ... GROUP BY ... ON CONFLICT DO UPDATE`. Backfill: `jobs run rollup-metrics-hourly --from --to`.",
  "acceptance_criteria": [
    {
      "id": "AC1",
      "given": "fixture rows",
      "when": "the job runs",
      "then": "the rollup values equal hand-computed ones"
    },
    {
      "id": "AC2",
      "given": "the job runs twice for the same hour",
      "when": "the second run completes",
      "then": "the results are identical"
    },
    {
      "id": "AC3",
      "given": "a late row for the previous hour",
      "when": "the next run completes",
      "then": "the rollup includes it"
    }
  ],
