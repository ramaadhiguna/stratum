  "user_story": {
    "as_a": "platform",
    "i_want": "future daily partitions created automatically",
    "so_that": "inserts never fall into the default partition"
  },
  "description": "The `maintain-partitions` job runs daily at 00:05 UTC and calls `telemetry.ensure_partitions(7)` (STR-501). It also counts rows sitting in default partitions and WARNs if any exist.",
  "acceptance_criteria": [
    {
      "id": "AC1",
      "given": "the job runs",
      "when": "it completes",
      "then": "partitions exist for today through +7 for all 3 tables"
    },
    {
      "id": "AC2",
      "given": "the job runs twice",
      "when": "the second run completes",
      "then": "nothing changes and nothing errors"
    },
    {
      "id": "AC3",
      "given": "rows in a default partition",
      "when": "the job runs",
      "then": "a WARN reports the count per table, and job_runs.details lists created partitions"
    }
  ],
