  "title": "Background jobs, reliability & operations",
  "status": "Backlog",
  "summary": "Scheduled maintenance jobs, self-healing, DLQ tooling, metrics and containerised services.",
  "goal": "The platform maintains itself (partitions, retention, rollups), heals stuck work, surfaces failures (DLQ depth, metrics), and starts entirely in containers.",
  "aws_services_replaced": [
    "EventBridge Scheduler (jobs)",
    "S3 lifecycle rules (retention job)",
    "SQS DLQ redrive",
    "CloudWatch metrics (Prometheus)"
  ],
