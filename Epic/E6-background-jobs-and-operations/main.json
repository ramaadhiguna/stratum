  "success_criteria": [
    "Partitions always exist ahead of time, and expired data is removed.",
    "Hourly metric rollups are correct and idempotent.",
    "Stuck files are re-queued automatically; DLQs can be inspected and redriven.",
    "Every service exposes Prometheus metrics, and the whole platform starts with one compose command."
  ],
